# SMTP Configuration (optional — without it, form submissions are accepted but not emailed)

# Resend (recommended — free tier: 100 emails/day)
#   1. Sign up at https://resend.com
#   2. Get an API key
#   3. Use onboarding@resend.dev as FROM_EMAIL (or verify your domain)

# Gmail (requires 2-Step Verification + App Password)
#   1. Enable 2FA at https://myaccount.google.com/security
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char code as SMTP_PASS

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
FROM_EMAIL=onboarding@resend.dev
CONTACT_TO=your-email@example.com
SITE_URL=127.0.0.1:3000
